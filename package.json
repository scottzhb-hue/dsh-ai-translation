{
  "name": "@scottzhb-hue/dsh-ai-translation",
  "version": "1.2.13",
  "license": "Apache-2.0",
  "author": {
    "name": "scottzhb-hue",
    "email": "scottzhb@gmail.com",
    "url": "https://github.com/scottzhb-hue"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzhb-hue/dsh-ai-translation.git"
  },
  "homepage": "https://github.com/scottzhb-hue/dsh-ai-translation#readme",
  "bugs": {
    "url": "https://github.com/scottzhb-hue/dsh-ai-translation/issues"
  },
  "description": "AI-assisted translation workbench for DeepSeek Harness — a fork of CAIT with local enhancements (segment merge/split, AI chat, term capture, draft recovery, route robustness, usage stats).",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cat",
    "translation",
    "translation-memory",
    "glossary",
    "docx",
    "xlsx",
    "pptx",
    "xliff",
    "cait",
    "fork"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "bench": "node scripts/bench-scale.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check": "npm run lint && npm run format:check && npm run check:locales && npm run check:errors && npm run check:store && npm run check:formats && npm run check:shared && npm run check:api && npm run check:client && npm run check:undef && npm test",
    "check:api": "node scripts/check-api.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:errors": "node scripts/check-errors.mjs",
    "check:formats": "node scripts/check-formats.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:store": "node scripts/check-store.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint lib index.js scripts _dev client",
    "test": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs",
    "check:publish": "node --experimental-vm-modules scripts/check-publish.mjs",
    "prepublishOnly": "npm run check:publish",
    "check:undef": "node scripts/check-undef.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client",
    "scripts",
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "CHANGELOG.md",
    "OPTIMIZATIONS.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "contributors": [
    {
      "name": "Jovi Lecca",
      "url": "https://github.com/JoviLecca"
    }
  ]
}
